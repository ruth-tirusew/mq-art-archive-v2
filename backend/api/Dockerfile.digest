FROM golang:1.25.12-bookworm AS builder

WORKDIR /app

COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -o /digest ./cmd/digest

FROM gcr.io/distroless/static-debian12

WORKDIR /
COPY --from=builder /digest /digest

USER nonroot:nonroot
ENTRYPOINT ["/digest"]
