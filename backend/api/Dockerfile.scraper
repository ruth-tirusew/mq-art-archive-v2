FROM golang:1.25.12-bookworm AS builder

WORKDIR /app

COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -o /scraper ./cmd/scraper

FROM gcr.io/distroless/static-debian12

WORKDIR /
COPY --from=builder /scraper /scraper

USER nonroot:nonroot
ENTRYPOINT ["/scraper"]
